# Backend AMP - configuración local (sobrescribe defaults en app/core/config.py)
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://wolfpack:wolfpack@localhost:5439/wolfpack
REDIS_URL=redis://localhost:6382/0

# changeme en produccion
ADMIN_API_KEY=dev-admin-key-change-me
JWT_SECRET=change-me-jwt-secret

# Required for database-backed provider secrets. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_SECRETS_MASTER_KEY=

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wolfpack-events

WOLFPACK_AUTO_SEED=1

# A runtime replica is online only while it renews its Mesh heartbeat.
MESH_HEARTBEAT_TTL_SECONDS=90

# Durable local ingestion worker
INGESTION_JOB_MAX_ATTEMPTS=3
INGESTION_JOB_LOCK_SECONDS=300
INGESTION_WORKER_POLL_SECONDS=1

# Optional Inngest dispatch. Local BackgroundTasks remains the default fallback.
# Install with: uv sync --extra inngest
# For the local Inngest dev server, set both values below. Cloud additionally
# requires INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY from the Inngest dashboard.
INGESTION_DISPATCHER=local
INNGEST_APP_ID=wolfpack-amp
# INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Schedules use Postgres as the source of truth. Set `inngest` to have an
# Inngest cron invoke the durable poller; otherwise the AMP local poller runs.
SCHEDULER_DISPATCHER=local
SCHEDULER_POLL_SECONDS=1
SCHEDULER_LEASE_SECONDS=300
SCHEDULER_DEADLINE_SECONDS=3600
# HTTP dispatch selects a fresh heartbeat instance, but always calls this
# administratively configured registration endpoint, never heartbeat metadata.
SCHEDULER_HTTP_ALLOWED_HOSTS=
SCHEDULER_ALLOW_INSECURE_HTTP=0
SCHEDULER_DISPATCH_SECRET=
SCHEDULER_CALLBACK_SECRET=

# Telegram is disabled unless all settings below are explicitly configured.
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_REGISTRATION_ID=
TELEGRAM_DELIVERY_ATTEMPTS=3
